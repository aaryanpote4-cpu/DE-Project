# Server Configuration
PORT=3000

# MySQL Relational Database Configuration
# Core graph entities: locations, edges (routes), orders
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=logistics_db

# MongoDB NoSQL Database Configuration (Node.js driver & Python PyMongo)
# Unstructured & Telemetry entities: activity_logs, order_tracking, inventory
# Can be local (mongodb://localhost:27017) or remote (MongoDB Atlas connection string)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=logistics_db
